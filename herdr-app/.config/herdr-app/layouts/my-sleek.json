{
  "id": "root",
  "cloned_from": {
    "name": "my-combined",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "sleek-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "sleek-workspaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "activity",
              "type": "block",
              "content": {
                "mod": "sleek-activity"
              },
              "size": {
                "px": 60
              }
            },
            {
              "id": "usage",
              "type": "block",
              "content": {
                "mod": "sleek-usage"
              },
              "size": {
                "px": 164
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "sleek-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 40
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "radius": 10
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "sleek-tabs"
          },
          "size": {
            "px": 40
          },
          "window_drag": true,
          "background": "chrome",
          "radius": 10
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "sleek-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": [
            6,
            0
          ],
          "gap": 6
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "sleek-status"
          },
          "size": {
            "px": 28
          },
          "background": "chrome",
          "radius": 10
        },
        {
          "id": "my-keys",
          "type": "block",
          "content": {
            "mod": "my-keys"
          },
          "size": {
            "px": 0
          }
        }
      ],
      "resizable": false,
      "gap": 0
    }
  ],
  "background": "#0b0a11",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    18,
    20
  ],
  "padding": 6,
  "gap": 6,
  "colors": {
    "dim": "#8a86a3",
    "muted": "#aaa6c3"
  },
  "theme": {
    "light": "paper",
    "dark": "rose-pine"
  }
}
